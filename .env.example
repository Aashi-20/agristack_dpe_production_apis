PORT=4000

# --- Redis (required -- backs every cache in this app: our own service
# token, introspection results, learned subject mappings, service config,
# sender/service authorization, AIU public keys). See README for exactly
# what's cached under which key and for how long. ---
REDIS_URL=redis://localhost:6379

# --- ClickHouse (required -- all GraphQL data and telemetry writes use this) ---
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=dpe_db

# Separate database for every table THIS app created (config, dedup,
# learned mappings, telemetry/audit, public keys). Deliberately different
# from CLICKHOUSE_DB above, which still holds the pre-existing
# farmer_demographic/land/land_ownership tables fed by materialized views
# this app doesn't own -- those stay in CLICKHOUSE_DB, untouched.
CLICKHOUSE_DATA_SHARING_DB=dpe_data_sharing

# --- Network Manager auth (required -- v1/v2 seek routes always verify tokens for real) ---
NM_TOKEN_URL=https://ufsi.agristack.gov.in/nm-auth/realms/sunbird-rc/protocol/openid-connect/token
NM_INTROSPECT_URL=https://ufsi.agristack.gov.in/nm/introspect-token
NM_CLIENT_ID=registry-frontend
NM_USERNAME=
NM_PASSWORD=

# true/false: whether to verify an AIU's bearer token locally instead of
# always calling the real Network Manager introspect API. false (default)
# = every request calls introspect (cached -- see TOKEN_INTROSPECT_CACHE_TTL_MS
# above). true = checks expiry locally + the learned sub/sender_id mapping
# in dpe_db.known_aiu_token_subject, falling back to ONE real introspect
# call the first time it sees a new sub/sender_id pair. See
# src/auth/verifyTokenMiddleware.js for exactly how the two combine.
USE_LOCAL_TOKEN_VALIDATION=false

# Paste the exact raw value from Keycloak's Realm Settings -> Keys ->
# (RS256/SIG row) -> "Public key" button -- no need to add PEM headers or
# line-wrap it yourself, the code does that. Setting this is enough to
# enable REAL signature verification (no network call needed) -- takes
# priority over NM_JWKS_URL below if both happen to be set.
NM_PUBLIC_KEY=

# Alternative to NM_PUBLIC_KEY: fetch the key live from a JWKS endpoint
# instead of a fixed value (handles UFSI rotating their key automatically).
# Only used if NM_PUBLIC_KEY above is empty. Try swapping /token for
# /certs on your NM_TOKEN_URL above -- that's the standard Keycloak
# convention for where this is published.
NM_JWKS_URL=
# Must exactly match the "iss" claim inside real tokens. Confirmed from a
# real decoded token during development -- verify this still matches if
# UFSI's realm configuration ever changes. Only used once NM_JWKS_URL is set.
NM_EXPECTED_ISSUER=http://10.1.0.11:7081/auth/realms/sunbird-rc

# Set to true ONLY for local dev if outbound HTTPS calls fail with
# "unable to get local issuer certificate" (common on corporate networks).
# Disables TLS certificate verification. NEVER set true outside local dev.
DEV_DISABLE_TLS_VERIFY=false

# Caps how long a token's introspection result can be cached (ms), even if
# the token's own real expiry is later than this. The actual cache duration
# per token is min(token's real remaining lifetime, this cap) -- so with
# this Network Manager's real 12-hour tokens, this cap has no effect unless
# a token's remaining lifetime is somehow longer than 12h. Default 12 hours.
TOKEN_INTROSPECT_CACHE_TTL_MS=43200000

# How long to cache (in Redis) admin-managed data that rarely changes --
# used by FOUR separate caches: the learned sub<->sender_id mapping
# (subjectMapping.js), sender/service authorization (senderServiceMap.js),
# AIU service config (serviceConfig.js), and AIU public keys
# (keyRegistry.js). A change to any of these can take up to this long to
# actually apply (or delete the specific Redis key to clear it
# immediately). Default 24 hours.
CONFIG_CACHE_TTL_MS=86400000

# How long (ms) a transaction_id is remembered for duplicate-rejection
# purposes in Redis, via an atomic SET ... NX EX (see
# src/orchestrator/transactionDedup.js). After this window, the same
# transaction_id could technically be reused without being caught -- 24h is
# a reasonable replay-protection window; a PERMANENT record of every
# transaction_id still exists in ClickHouse regardless (fire-and-forget,
# for audit -- not part of the accept/reject decision, which Redis alone
# makes, atomically). Default 24 hours.
TRANSACTION_DEDUP_TTL_MS=172800000

# --- Kafka: async (v1) seek request queueing ---
# false = v1 does the work in-process instead of via Kafka (no broker needed).
USE_KAFKA=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=agristack-dpe
KAFKA_SEEK_REQUEST_TOPIC=agristack.seek.requests
KAFKA_CONSUMER_GROUP_ID=agristack-seek-consumer

# --- Kafka: audit/telemetry/transparency (seek-processed event) ---
# Published by BOTH sync and async paths when true. Requires the tables in
# clickhouse/telemetry_tables.sql to exist and npm run telemetry-consumer
# to be running.
USE_TELEMETRY_EVENTS=false
KAFKA_SEEK_PROCESSED_TOPIC=agristack.seek.processed
KAFKA_TELEMETRY_GROUP_ID=agristack-telemetry-fanout
# '_dist' if you used the Distributed/cluster DDL, '' (empty) if you used the
# single-node DDL variant in clickhouse/telemetry_tables.sql.
TELEMETRY_TABLE_SUFFIX=_dist

# Only needed if you split a profile out into its own deployed service later
DEMOGRAPHIC_GRAPHQL_URL=http://127.0.0.1:4000/graphql/demographic
LAND_GRAPHQL_URL=http://127.0.0.1:4000/graphql/land
LAND_OWNERSHIP_GRAPHQL_URL=http://127.0.0.1:4000/graphql/land-ownership

# true/false: envelope-encrypt message.seek_response in the v2 sync response
# using the requesting AIU's registered public key (dpe_db.aiu_public_key).
# false (default) = unchanged plaintext response. If true and the AIU has
# no registered key, the request FAILS rather than silently sending
# plaintext.
USE_RESPONSE_ENCRYPTION=false
